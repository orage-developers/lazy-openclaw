{
  "name": "openclaw-plugin-lazy-loading",
  "version": "0.1.0",
  "description": "OpenClaw plugin that loads agent tools on demand to cut time-to-first-token.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && openclaw plugins build",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \".test-build/test/**/*.test.js\"",
    "validate": "openclaw plugins validate --json",
    "pack": "openclaw plugins pack --json"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.9.5"
  },
  "dependencies": {
    "typebox": "^1.3.17"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "openclaw": "2026.9.5",
    "typescript": "^5.9.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "controlUi": "./src/control-ui.ts",
    "compat": {
      "pluginApi": ">=2026.9.5"
    },
    "build": {
      "openclawVersion": "2026.9.5"
    }
  }
}
